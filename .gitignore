# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# `.env` est ignoré sans exception : les variables `EXPO_PUBLIC_*` finissent en
# clair dans le paquet compilé, mais le fichier qui les contient n'a pas à être
# versionné pour autant — il porte aussi les valeurs d'un éventuel autre projet.
.env
.env*.local

# typescript
*.tsbuildinfo

# supabase : état local de la ligne de commande (liaison au projet, cache)
supabase/.temp/

# generated native folders
/ios
/android

# artefacts de compilation
*.ipa
*.apk
*.aab
Payload/

# Journal de travail et notes de projet : hors du code livré, et sans intérêt
# pour quiconque clone le dépôt.
.workbuddy-ai/
